# Configurações do LiveKit Server para Produção na VPS
# Renomeie para .env na sua VPS (cp .env.example .env)

# Domínio apontado para o IP da sua VPS Hostinger (Ex: livekit.seusite.com.br)
DOMAIN=livekit.seusite.com.br

# Chaves de API do LiveKit Server (Gere com: ./bin/livekit-server generate-keys ou invente uma senha forte)
LIVEKIT_API_KEY=API_SUA_CHAVE_FORTE_AQUI
LIVEKIT_API_SECRET=SECRET_SUA_SENHA_MUITO_SECRETA_AQUI
